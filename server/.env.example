# CampusSync Server Environment Configuration (Placeholders)
# Copy this file to server/.env and fill with production / local secrets.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/campussync

# JWT Secret (Must be strong and kept private)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_placeholder
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Campus Email Policy
ALLOWED_EMAIL_DOMAIN=campussync.edu
REQUIRE_CAMPUS_EMAIL=false

# Optional Cloudinary (For cloud persistent storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP Settings (For transactional emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@campussync.edu
