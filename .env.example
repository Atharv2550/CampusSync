# CampusSync Environment Configuration (Placeholders)
# Copy this file to .env in production / local dev and update with your credentials.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/campussync

# JWT Authentication
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_placeholder
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Campus Email Policy
ALLOWED_EMAIL_DOMAIN=campussync.edu
REQUIRE_CAMPUS_EMAIL=false

# Optional Cloudinary (Leave empty for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP Settings (Leave empty to use console logger)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@campussync.edu
